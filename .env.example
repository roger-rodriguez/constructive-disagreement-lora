# Populated after deploying `disagree_serving.modal_app`.
MODAL_HEALTH_URL=https://YOUR-WORKSPACE--constructive-disagreement-health.modal.run
MODAL_DECISION_URL=https://YOUR-WORKSPACE--constructive-disagreement.modal.run

# Send these as the Modal-Key and Modal-Secret headers. Use a dedicated proxy
# token for shared access; never expose Modal credentials in client-side code,
# logs, screenshots, or committed files.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
